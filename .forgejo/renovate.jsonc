{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",

  // self-hosted
  "onboarding": false,
  "requireConfig": "ignored",
  "platform": "forgejo",
  "endpoint": "https://trev.zip/api/v1",
  "repositories": ["llc/bumper"],

  // repository
  "extends": ["config:recommended"],
  "addLabels": ["dep"],
  "prHourlyLimit": 0,
  "nix": {
    "enabled": true
  },
  // fix PRs for vulnerable direct dependencies, from osv.dev.
  // transitive vulnerabilities are reported by the vulnerable workflow
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": { "osvVulnerabilitySummary": "unresolved" },
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 0"] // sunday
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["nix"],
      "addLabels": ["nix"]
    },
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      "matchManagers": ["cargo"],
      "addLabels": ["rust"]
    }
  ]
}
